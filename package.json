{
  "name": "@opencorestack/opengridx",
  "version": "3.2.2",
  "description": "OpenGridX: High-performance React data infrastructure. Unlock advanced Row Grouping, Excel Export, and Column Pinning without the usual \"Pro\" gatekeeping. Built for speed, scale, and complete architectural freedom. Fully open, virtualization-ready, and feature-complete.",
  "type": "module",
  "main": "./dist/opengridx.umd.js",
  "module": "./dist/opengridx.es.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/opengridx.es.js",
      "require": "./dist/opengridx.umd.js"
    },
    "./styles": {
      "types": "./dist/opengridx.css.d.ts",
      "default": "./dist/opengridx.css"
    }
  },
  "files": [
    "dist",
    "lib",
    "!lib/**/*.test.ts",
    "!lib/**/*.test.tsx",
    "!lib/**/__screenshots__",
    "docs/architecture",
    "docs/assets",
    "docs/components",
    "docs/customization",
    "docs/features",
    "docs/migration",
    "docs/API_REFERENCE.md",
    "docs/README.md",
    "docs/performance.md",
    "docs/roadmap.md",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "llms.txt"
  ],
  "sideEffects": [
    "**/*.css",
    "**/*.scss"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc --project tsconfig.build.json && vite build",
    "build:lib": "tsc --project tsconfig.build.json && vite build --config vite.config.lib.js && cp lib/styles/opengridx.css.d.ts dist/opengridx.css.d.ts && node scripts/check-bundle.mjs",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit && tsc -p e2e/tsconfig.json",
    "preview": "vite preview",
    "test": "vitest run --project unit",
    "test:browser": "vitest run --project browser",
    "test:all": "vitest run",
    "test:smoke": "node scripts/smoke.mjs",
    "test:watch": "vitest --project unit",
    "coverage": "vitest run --coverage",
    "prepublishOnly": "npm run build:lib"
  },
  "keywords": [
    "react",
    "datagrid",
    "opengridx",
    "table",
    "data-table",
    "virtualization",
    "row-grouping",
    "excel-export",
    "pivot-table",
    "typescript",
    "free-datagrid",
    "enterprise-grid",
    "mui-datagrid-alternative",
    "ag-grid-alternative",
    "row-spanning",
    "column-pinning",
    "react-table",
    "high-performance-table"
  ],
  "author": "Asif Ansari <asif.ansari7774@gmail.com>",
  "license": "MIT",
  "homepage": "https://opencorestack.github.io/OpenGridX/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OpenCoreStack/OpenGridX.git"
  },
  "bugs": {
    "url": "https://github.com/OpenCoreStack/OpenGridX/issues"
  },
  "peerDependencies": {
    "exceljs": ">=4.0.0",
    "jspdf": ">=2.5.0",
    "jspdf-autotable": ">=3.8.0",
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "peerDependenciesMeta": {
    "exceljs": {
      "optional": true
    },
    "jspdf": {
      "optional": true
    },
    "jspdf-autotable": {
      "optional": true
    }
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@playwright/test": "^1.58.2",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^25.0.8",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "@vitest/browser-playwright": "^4.1.11",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "exceljs": "^4.4.0",
    "globals": "^16.5.0",
    "jsdom": "^29.1.1",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "playwright": "^1.58.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.13.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^7.2.4",
    "vite-plugin-dts": "^4.5.4",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "uuid": "^11.1.1"
  }
}
